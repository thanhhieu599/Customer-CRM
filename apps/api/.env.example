# PostgreSQL
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"
# Auth – change in production (openssl rand -hex 32)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"
# App
PORT=4000
TZ_BUSINESS="Asia/Ho_Chi_Minh"
# Set to "false" to disable the scheduled retention jobs (e.g. on a 2nd API instance)
SCHEDULER_ENABLED="true"
# Cookie "secure" flag – true behind HTTPS
COOKIE_SECURE="false"

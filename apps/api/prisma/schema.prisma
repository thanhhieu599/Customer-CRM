// Customer Care CRM – data model (MVP V1)
// Conventions: snake_case tables/columns, UUID ids, money as Decimal(18,2).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Users & access ─────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedCustomers  Customer[]      @relation("CustomerOwner")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  activities      Activity[]
  ticketComments  TicketComment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  savedFilters    SavedFilter[]

  @@map("users")
}

// ───────────────────────── Customers ─────────────────────────

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerSegment {
  NEW
  REGULAR
  VIP
  AT_RISK
  DORMANT
}

enum HealthLevel {
  HEALTHY
  WATCH
  AT_RISK
}

model Customer {
  id       String       @id @default(uuid()) @db.Uuid
  code     String       @unique // internal customer code (e.g. MISA customer code)
  name     String
  type     CustomerType @default(COMPANY)
  taxCode  String?      @unique @map("tax_code")
  industry String? // electronics, food, steel, oil_gas, construction, glass…
  tier     String? // A / B / C – set by sales manager
  source   String? // website, referral, tender, cold_call…
  phone    String?
  email    String?
  address  String?
  notes    String?
  ownerId  String?      @map("owner_id") @db.Uuid
  owner    User?        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Consent for automated marketing messages (email / Zalo / SMS).
  marketingConsent Boolean @default(false) @map("marketing_consent")

  // ── Computed by the retention engine ──
  segment         CustomerSegment @default(NEW)
  healthScore     Int?            @map("health_score")
  healthLevel     HealthLevel?    @map("health_level")
  healthReasons   Json?           @map("health_reasons")
  healthUpdatedAt DateTime?       @map("health_updated_at")
  firstOrderAt    DateTime?       @map("first_order_at") @db.Date
  lastOrderAt     DateTime?       @map("last_order_at") @db.Date
  orderCycleDays  Int?            @map("order_cycle_days")
  orderCount      Int             @default(0) @map("order_count")
  revenueTotal    Decimal         @default(0) @map("revenue_total") @db.Decimal(18, 2)
  revenue12m      Decimal         @default(0) @map("revenue_12m") @db.Decimal(18, 2)
  revenuePrev12m  Decimal         @default(0) @map("revenue_prev_12m") @db.Decimal(18, 2)
  lastActivityAt  DateTime?       @map("last_activity_at")

  // From accounting (MISA): max overdue days of open receivables.
  overdueDebtDays Int? @map("overdue_debt_days")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  mergedIntoId String? @map("merged_into_id") @db.Uuid
  mergedInto Customer? @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom Customer[] @relation("CustomerMerge")

  contacts   CustomerContact[]
  tags       CustomerTagRelation[]
  orders     Order[]
  activities Activity[]
  tasks      Task[]
  tickets    Ticket[]
  executions AutomationExecution[]
  opportunities Opportunity[]

  @@index([ownerId])
  @@index([segment])
  @@index([healthLevel])
  @@index([lastOrderAt])
  @@map("customers")
}

enum ContactRole {
  PURCHASING
  EHS
  QA
  WAREHOUSE
  ADMIN
  PRODUCTION
  OTHER
}

model CustomerContact {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String      @map("customer_id") @db.Uuid
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  title             String?
  role              ContactRole @default(OTHER)
  isDecisionMaker   Boolean     @default(false) @map("is_decision_maker")
  isPrimary         Boolean     @default(false) @map("is_primary")
  phone             String?
  email             String?
  zaloId            String?     @map("zalo_id")
  marketingOptOut   Boolean     @default(false) @map("marketing_opt_out")
  leftCompanyAt     DateTime?   @map("left_company_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  activities Activity[]
  tickets    Ticket[]

  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerTag {
  id        String                @id @default(uuid()) @db.Uuid
  name      String                @unique
  color     String?
  customers CustomerTagRelation[]

  @@map("customer_tags")
}

model CustomerTagRelation {
  customerId String      @map("customer_id") @db.Uuid
  tagId      String      @map("tag_id") @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_relations")
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  CONFIRMED
  DELIVERED
  CANCELED
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique // order / voucher number from source system
  customerId  String      @map("customer_id") @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderDate   DateTime    @map("order_date") @db.Date
  deliveredAt DateTime?   @map("delivered_at") @db.Date
  status      OrderStatus @default(CONFIRMED)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(18, 2)
  source      String      @default("manual") // manual, csv, misa, sapo
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([customerId, orderDate])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String
  productName String  @map("product_name")
  quantity    Decimal @db.Decimal(18, 3)
  unit        String?
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)

  @@index([orderId])
  @@index([sku])
  @@map("order_items")
}

// ───────────────────────── Activities (timeline) ─────────────────────────

enum ActivityType {
  CALL
  EMAIL
  ZALO
  MEETING
  VISIT
  NOTE
  ORDER
  TICKET
  STATUS_CHANGE
  SYSTEM
}

enum ActivityOutcome {
  POSITIVE
  NEUTRAL
  NEGATIVE
  NO_ANSWER
}

model Activity {
  id         String           @id @default(uuid()) @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId  String?          @map("contact_id") @db.Uuid
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId     String?          @map("user_id") @db.Uuid
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       ActivityType
  outcome    ActivityOutcome?
  content    String
  metadata   Json?
  occurredAt DateTime         @default(now()) @map("occurred_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([customerId, occurredAt])
  @@map("activities")
}

// ───────────────────────── Tasks (follow-up center) ─────────────────────────

enum TaskType {
  FOLLOW_UP
  CALL
  REORDER
  WIN_BACK
  POST_DELIVERY
  TICKET
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskSource {
  MANUAL
  AUTOMATION
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  type        TaskType   @default(FOLLOW_UP)
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(OPEN)
  source      TaskSource @default(MANUAL)
  dueAt       DateTime   @map("due_at")
  completedAt DateTime?  @map("completed_at")
  result      String? // what happened when the task was done
  customerId  String?    @map("customer_id") @db.Uuid
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticketId    String?    @map("ticket_id") @db.Uuid
  ticket      Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assigneeId  String?    @map("assignee_id") @db.Uuid
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?    @map("created_by_id") @db.Uuid
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  quoteId     String?    @unique @map("quote_id") @db.Uuid
  quote       Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  execution AutomationExecution?

  @@index([assigneeId, status, dueAt])
  @@index([customerId])
  @@map("tasks")
}

// Phase 1: a customer's owner is the single source of sales access.
enum OpportunityStage {
  NEW
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

model Opportunity {
  id String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  title String
  stage OpportunityStage @default(NEW)
  value Decimal @default(0) @db.Decimal(18, 2)
  expectedCloseAt DateTime @map("expected_close_at") @db.Date
  nextActionAt DateTime @map("next_action_at")
  lossReason String? @map("loss_reason")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  quotes Quote[]
  @@index([customerId, stage])
  @@index([stage, nextActionAt])
  @@map("opportunities")
}

// Issued versions keep their own customer and line-item snapshots.
model Quote {
  id String @id @default(uuid()) @db.Uuid
  opportunityId String @map("opportunity_id") @db.Uuid
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  number String @unique
  version Int
  status QuoteStatus @default(DRAFT)
  customerSnapshot Json @map("customer_snapshot")
  items Json
  subtotal Decimal @db.Decimal(18, 2)
  discountAmount Decimal @map("discount_amount") @db.Decimal(18, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(18, 2)
  total Decimal @db.Decimal(18, 2)
  vatPercent Decimal @map("vat_percent") @db.Decimal(5, 2)
  validUntil DateTime @map("valid_until") @db.Date
  followUpAt DateTime @map("follow_up_at")
  notes String?
  createdAt DateTime @default(now()) @map("created_at")
  sentAt DateTime? @map("sent_at")
  task Task?
  @@unique([opportunityId, version])
  @@index([status, followUpAt])
  @@map("quotes")
}

model SavedFilter {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  resource String
  filters Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, resource, name])
  @@map("saved_filters")
}

// ───────────────────────── Tickets (complaints / requests) ─────────────────────────

enum TicketCategory {
  QUALITY
  DELIVERY
  DOCUMENT
  PRICING
  REQUEST
  OTHER
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model Ticket {
  id              String           @id @default(uuid()) @db.Uuid
  number          Int              @unique @default(autoincrement())
  subject         String
  description     String?
  category        TicketCategory   @default(OTHER)
  priority        Priority         @default(NORMAL)
  status          TicketStatus     @default(NEW)
  customerId      String           @map("customer_id") @db.Uuid
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactId       String?          @map("contact_id") @db.Uuid
  contact         CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId      String?          @map("assignee_id") @db.Uuid
  assignee        User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  slaDueAt        DateTime         @map("sla_due_at")
  slaBreached     Boolean          @default(false) @map("sla_breached")
  firstResponseAt DateTime?        @map("first_response_at")
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  comments TicketComment[]
  tasks    Task[]

  @@index([status, slaDueAt])
  @@index([customerId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?  @map("author_id") @db.Uuid
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_comments")
}

// ───────────────────────── Automation (retention engine) ─────────────────────────

enum AutomationTrigger {
  NO_ORDER_FOR_CYCLE // customer is past its usual reorder cycle
  REORDER_DUE // a SKU is predicted to be reordered soon
  POST_DELIVERY // check-in N days after delivery
  TICKET_SLA_BREACH // complaint past its SLA
  HEALTH_AT_RISK // health score dropped into AT_RISK
  VIP_NO_CONTACT // VIP with no interaction for N days
}

enum ExecutionStatus {
  SUCCESS
  SKIPPED
  FAILED
}

model AutomationRule {
  id        String            @id @default(uuid()) @db.Uuid
  key       String            @unique
  name      String
  trigger   AutomationTrigger
  config    Json              @default("{}")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  executions AutomationExecution[]

  @@map("automation_rules")
}

model AutomationExecution {
  id             String          @id @default(uuid()) @db.Uuid
  ruleId         String          @map("rule_id") @db.Uuid
  rule           AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Unique per (rule, subject, occurrence) – prevents duplicate tasks on re-runs.
  idempotencyKey String          @unique @map("idempotency_key")
  status         ExecutionStatus
  customerId     String?         @map("customer_id") @db.Uuid
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  taskId         String?         @unique @map("task_id") @db.Uuid
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  error          String?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([ruleId, createdAt])
  @@map("automation_executions")
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ───────────────────────── Integrations ─────────────────────────

model ExternalIdMapping {
  id         String   @id @default(uuid()) @db.Uuid
  system     String // misa, sapo, csv…
  entityType String   @map("entity_type") // customer, order, contact
  externalId String   @map("external_id")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([system, entityType, externalId])
  @@index([entityType, entityId])
  @@map("external_id_mappings")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model SyncLog {
  id         String     @id @default(uuid()) @db.Uuid
  system     String
  kind       String // customers, orders
  status     SyncStatus @default(RUNNING)
  stats      Json?
  errors     Json?
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")

  @@map("sync_logs")
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // create, update, delete, login, import…
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
